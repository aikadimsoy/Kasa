# kasa.toml — Project KASA Configuration
# Copy to kasa.toml and customize. Bearer token is auto-generated on first run.

[server]
host = "127.0.0.1"
port = 8000
bearer_token = ""   # auto-filled on first run
# Turkce not: "null" origin BILEREK cikarildi — sandbox'li iframe, data: ve file://
# baglamlari Origin basligini "null" olarak gonderir; listede olmasi taze kurulumda CORS'u
# "yalniz localhost" olmaktan cikarirdi. Bu satir artik kod-ici varsayilanla (src/config.py)
# birebir ayni. Ihtiyacin varsa bilerek ekle.
allowed_origins = ["http://localhost", "http://127.0.0.1"]

[vault]
path = "~/.kasa/vault"   # use absolute path or ~ for home dir
ttl_days = 30

[distill]
model = "qwen2.5:7b"
ollama_url = "http://localhost:11434"
schedule_hour = 2        # 02:00 local time
