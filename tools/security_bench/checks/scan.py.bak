import subprocess
import shutil

def run():
    results = []
    
    # Bandit Scan
    if shutil.which("bandit") is None:
        result = {
            "id": "SCAN-BANDIT",
            "category": "scan",
            "title": "Static Analysis with Bandit",
            "status": "SKIP",
            "severity": "info",
            "evidence": "Bandit not installed. Remediation: pip install bandit.",
            "remediation": "pip install bandit; review src findings"
        }
        results.append(result)
    else:
        try:
            cmd = ["bandit", "-r", "src", "-f", "json"]
            process = subprocess.run(cmd, cwd="d:/kasa", capture_output=True, text=True, timeout=300)
            data = process.stdout
            try:
                import json
                results_data = json.loads(data)
                high_issues = sum(1 for result in results_data["results"] if result["issue_severity"] == "HIGH")
                medium_issues = sum(1 for result in results_data["results"] if result["issue_severity"] == "MEDIUM")
                
                status = "PASS"
                evidence = f"High: {high_issues}, Medium: {medium_issues}"
                if high_issues > 0:
                    status = "FAIL"
                    evidence += "; Found HIGH severity issues."
                elif medium_issues > 0:
                    status = "WARN"
                    evidence += "; Found MEDIUM severity issues."
                
                result = {
                    "id": "SCAN-BANDIT",
                    "category": "scan",
                    "title": "Static Analysis with Bandit",
                    "status": status,
                    "severity": "high",
                    "evidence": evidence,
                    "remediation": "pip install bandit; review src findings"
                }
                results.append(result)
            except json.JSONDecodeError:
                result = {
                    "id": "SCAN-BANDIT",
                    "category": "scan",
                    "title": "Static Analysis with Bandit",
                    "status": "FAIL",
                    "severity": "high",
                    "evidence": f"Failed to parse output: {data}",
                    "remediation": "pip install bandit; review src findings"
                }
                results.append(result)
        except subprocess.TimeoutExpired:
            result = {
                "id": "SCAN-BANDIT",
                "category": "scan",
                "title": "Static Analysis with Bandit",
                "status": "FAIL",
                "severity": "high",
                "evidence": "Scan timed out.",
                "remediation": "pip install bandit; review src findings"
            }
            results.append(result)
        except Exception as e:
            result = {
                "id": "SCAN-BANDIT",
                "category": "scan",
                "title": "Static Analysis with Bandit",
                "status": "SKIP",
                "severity": "info",
                "evidence": f"Unexpected error: {str(e)}",
                "remediation": "pip install bandit"
            }
            results.append(result)
    
    # Pip Audit Scan
    if shutil.which("pip-audit") is None:
        result = {
            "id": "SCAN-PIPAUDIT",
            "category": "scan",
            "title": "Dependency Audit with pip-audit",
            "status": "SKIP",
            "severity": "info",
            "evidence": "pip-audit not installed. Remediation: pip install pip-audit.",
            "remediation": "pip install pip-audit; review requirements.txt findings"
        }
        results.append(result)
    else:
        try:
            cmd = ["pip-audit", "-r", "requirements.txt", "-f", "json"]
            process = subprocess.run(cmd, cwd="d:/kasa", capture_output=True, text=True, timeout=300)
            data = process.stdout
            try:
                import json
                results_data = json.loads(data)
                if isinstance(results_data, dict):
                    results_data = results_data["dependencies"]
                
                vulnerable_count = sum(1 for entry in results_data if "vulns" in entry or "vulnerabilities" in entry)
                
                status = "PASS"
                evidence = f"Vulnerable dependencies: {vulnerable_count}"
                if vulnerable_count > 0:
                    status = "FAIL"
                    evidence += "; Found vulnerable dependencies."
                
                result = {
                    "id": "SCAN-PIPAUDIT",
                    "category": "scan",
                    "title": "Dependency Audit with pip-audit",
                    "status": status,
                    "severity": "high",
                    "evidence": evidence,
                    "remediation": "pip install pip-audit; review requirements.txt findings"
                }
                results.append(result)
            except json.JSONDecodeError:
                result = {
                    "id": "SCAN-PIPAUDIT",
                    "category": "scan",
                    "title": "Dependency Audit with pip-audit",
                    "status": "FAIL",
                    "severity": "high",
                    "evidence": f"Failed to parse output: {data}",
                    "remediation": "pip install pip-audit; review requirements.txt findings"
                }
                results.append(result)
        except subprocess.TimeoutExpired:
            result = {
                "id": "SCAN-PIPAUDIT",
                "category": "scan",
                "title": "Dependency Audit with pip-audit",
                "status": "FAIL",
                "severity": "high",
                "evidence": "Scan timed out.",
                "remediation": "pip install pip-audit; review requirements.txt findings"
            }
            results.append(result)
        except Exception as e:
            result = {
                "id": "SCAN-PIPAUDIT",
                "category": "scan",
                "title": "Dependency Audit with pip-audit",
                "status": "SKIP",
                "severity": "info",
                "evidence": f"Network error: {str(e)}",
                "remediation": "pip install pip-audit"
            }
            results.append(result)
    
    # Secrets Scan
    if shutil.which("gitleaks") is None and shutil.which("trufflehog") is None:
        result = {
            "id": "SCAN-SECRETS",
            "category": "scan",
            "title": "Secret Detection with Gitleaks or Trufflehog",
            "status": "SKIP",
            "severity": "info",
            "evidence": "Neither gitleaks nor trufflehog installed. Remediation: install gitleaks (github.com/gitleaks/gitleaks) or trufflehog.",
            "remediation": "install gitleaks (github.com/gitleaks/gitleaks) or trufflehog; review filesystem findings"
        }
        results.append(result)
    elif shutil.which("gitleaks") is not None:
        try:
            cmd = ["gitleaks", "dir", ".", "--report-format", "json", "--report-path", "-", "--no-banner"]
            process = subprocess.run(cmd, cwd="d:/kasa", capture_output=True, text=True, timeout=300)
            data = process.stdout
            try:
                import json
                results_data = json.loads(data)
                
                if isinstance(results_data, list):
                    findings = results_data
                else:
                    findings = results_data.get("findings", [])
                
                status = "PASS"
                evidence = f"Findings found: {len(findings)}"
                if len(findings) > 0:
                    status = "FAIL"
                    first_finding = findings[0]
                    evidence += f"; First finding: {first_finding['rule']['description']} in {first_finding['file']}"
                
                result = {
                    "id": "SCAN-SECRETS",
                    "category": "scan",
                    "title": "Secret Detection with Gitleaks",
                    "status": status,
                    "severity": "critical",
                    "evidence": evidence,
                    "remediation": "Review filesystem findings"
                }
                results.append(result)
            except json.JSONDecodeError:
                result = {
                    "id": "SCAN-SECRETS",
                    "category": "scan",
                    "title": "Secret Detection with Gitleaks",
                    "status": "FAIL",
                    "severity": "critical",
                    "evidence": f"Failed to parse output: {data}",
                    "remediation": "Review filesystem findings"
                }
                results.append(result)
        except subprocess.TimeoutExpired:
            result = {
                "id": "SCAN-SECRETS",
                "category": "scan",
                "title": "Secret Detection with Gitleaks",
                "status": "FAIL",
                "severity": "critical",
                "evidence": "Scan timed out.",
                "remediation": "Review filesystem findings"
            }
            results.append(result)
        except Exception as e:
            result = {
                "id": "SCAN-SECRETS",
                "category": "scan",
                "title": "Secret Detection with Gitleaks",
                "status": "SKIP",
                "severity": "info",
                "evidence": f"Unexpected error: {str(e)}",
                "remediation": "install gitleaks (github.com/gitleaks/gitleaks); review filesystem findings"
            }
            results.append(result)
    elif shutil.which("trufflehog") is not None:
        try:
            cmd = ["trufflehog", "filesystem", ".", "--json", "--no-update"]
            process = subprocess.run(cmd, cwd="d:/kasa", capture_output=True, text=True, timeout=300)
            data = process.stdout
            try:
                import json
                results_data = json.loads(data)
                
                if isinstance(results_data, list):
                    findings = results_data
                else:
                    findings = results_data.get("findings", [])
                
                status = "PASS"
                evidence = f"Findings found: {len(findings)}"
                if len(findings) > 0:
                    status = "FAIL"
                    first_finding = findings[0]
                    evidence += f"; First finding: {first_finding['rule']['description']} in {first_finding['file']}"
                
                result = {
                    "id": "SCAN-SECRETS",
                    "category": "scan",
                    "title": "Secret Detection with Trufflehog",
                    "status": status,
                    "severity": "critical",
                    "evidence": evidence,
                    "remediation": "Review filesystem findings"
                }
                results.append(result)
            except json.JSONDecodeError:
                result = {
                    "id": "SCAN-SECRETS",
                    "category": "scan",
                    "title": "Secret Detection with Trufflehog",
                    "status": "FAIL",
                    "severity": "critical",
                    "evidence": f"Failed to parse output: {data}",
                    "remediation": "Review filesystem findings"
                }
                results.append(result)
        except subprocess.TimeoutExpired:
            result = {
                "id": "SCAN-SECRETS",
                "category": "scan",
                "title": "Secret Detection with Trufflehog",
                "status": "FAIL",
                "severity": "critical",
                "evidence": "Scan timed out.",
                "remediation": "Review filesystem findings"
            }
            results.append(result)
        except Exception as e:
            result = {
                "id": "SCAN-SECRETS",
                "category": "scan",
                "title": "Secret Detection with Trufflehog",
                "status": "SKIP",
                "severity": "info",
                "evidence": f"Unexpected error: {str(e)}",
                "remediation": "install trufflehog; review filesystem findings"
            }
            results.append(result)
    
    return results
