import sqlite3
from src.vault import schema
from src.vault.audit import AuditChain

def run():
    results = []
    
    try:
        # Create an in-memory database for the audit checks
        conn = sqlite3.connect(":memory:")
        conn.row_factory = sqlite3.Row
        
        if "CREATE_AUDIT_TABLE" not in schema.__dict__:
            if "ALL_TABLES" in schema.__dict__:
                for table_sql in schema.ALL_TABLES.values():
                    conn.execute(table_sql)
            else:
                results.append({
                    "id": "AUDIT-SCHEMA",
                    "category": "audit",
                    "title": "Audit Table Schema Missing",
                    "status": "FAIL",
                    "severity": "critical",
                    "evidence": "CREATE_AUDIT_TABLE not found and ALL_TABLES is missing",
                    "remediation": ""
                })
                conn.close()
                return results
        
        # Create the audit table if CREATE_AUDIT_TABLE exists
        conn.execute(schema.CREATE_AUDIT_TABLE)
        conn.commit()
        
        # Initialize AuditChain with the in-memory database connection
        ac = AuditChain(conn)
        
        # Record 3 initial entries
        ac.record("agentA", "vault_init", {"n": 1})
        ac.record("agentB", "profile_read", {"k": "x"})
        ac.record("agentC", "profile_write", {"k": "x", "v": "y"})
        
        # Check the integrity of the audit chain
        if ac.verify_chain():
            results.append({
                "id": "AUDIT-VERIFY",
                "category": "audit",
                "title": "Audit Chain Integrity Verified",
                "status": "PASS",
                "severity": "high",
                "evidence": "3-record chain verified",
                "remediation": ""
            })
        else:
            results.append({
                "id": "AUDIT-VERIFY",
                "category": "audit",
                "title": "Audit Chain Integrity Verification Failed",
                "status": "FAIL",
                "severity": "high",
                "evidence": "3-record chain failed verification",
                "remediation": ""
            })
        
        # Attempt to tamper with the audit records
        conn.execute("UPDATE audit SET action='tampered' WHERE id=2")
        conn.commit()
        
        if not ac.verify_chain():
            results.append({
                "id": "AUDIT-TAMPER-MODIFY",
                "category": "audit",
                "title": "Audit Chain Tamper Detection",
                "status": "PASS",
                "severity": "critical",
                "evidence": "Tampering detected in row 2",
                "remediation": ""
            })
        else:
            results.append({
                "id": "AUDIT-TAMPER-MODIFY",
                "category": "audit",
                "title": "Audit Chain Tamper Not Detected",
                "status": "FAIL",
                "severity": "critical",
                "evidence": "Tampering not detected after modification",
                "remediation": ""
            })
        
        # Attempt to delete an audit record
        conn.execute("DELETE FROM audit WHERE id=2")
        conn.commit()
        
        if not ac.verify_chain():
            results.append({
                "id": "AUDIT-TAMPER-DELETE",
                "category": "audit",
                "title": "Audit Chain Deletion Detection",
                "status": "PASS",
                "severity": "critical",
                "evidence": "Deletion detected in row 2",
                "remediation": ""
            })
        else:
            results.append({
                "id": "AUDIT-TAMPER-DELETE",
                "category": "audit",
                "title": "Audit Chain Deletion Not Detected",
                "status": "FAIL",
                "severity": "critical",
                "evidence": "Deletion not detected after deletion",
                "remediation": ""
            })
        
        conn.close()
    except Exception as e:
        results.append({
            "id": "AUDIT-ERROR",
            "category": "audit",
            "title": "Audit Check Execution Error",
            "status": "SKIP",
            "severity": "info",
            "evidence": str(e),
            "remediation": ""
        })
    
    return results
