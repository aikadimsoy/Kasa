# Secret'lar — bearer_token kasa.toml'da duz metin; git'te izlenmez (owner-only ACL + L1 rotasyon).
# Ornek/sablon kasa.toml.example izlenebilir.
kasa.toml

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Vault DB: rollback'i tam-kopya yedegi (d:\kasa_backup_*) + L2 migration .bak/export_vault
# ile korunuyor. Git yalniz KODU izler; binary DB'yi izlemez (diff kirliligi + gizli-veri).
kasa.db
kasa.db-wal
kasa.db-shm
*.db-wal
*.db-shm
kasa.db.bak*
# DPAPI-korumali vault anahtari (makine+kullanici bagli) — git'te izlenmez
.vaultkey

# Yerel model / orch runtime ciktilari (varsa) - kod degil
_orch/**/tasks/
*.log

# Stray backup dosyalari — loop_runner/edit araclari .bak biraktiginda git'e GIRMESIN
# (SCAN-BAK-HYGIENE her kosuda WARN uretir; bunlar da izlenmemeli). _bak_archive haric-tutulmaz
# cunku oradaki adlar .py uzantili; buradaki desenler yalniz gercek yedek uzantilarini yakalar.
*.bak
*.bak.*
*.bak_*
